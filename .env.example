# Leave empty for the local defaults:
# - Bun development: file:./data/db-studio.db
# - Docker Compose: file:/data/db-studio.db
# Remote example: libsql://your-database-your-org.turso.io
DATABASE_URL=

# Required for authenticated remote Turso; never commit a real token.
DATABASE_AUTH_TOKEN=

# Public URL used by the Bun adapter. Include the externally visible port.
ORIGIN=http://localhost:3000

# Host port published by Docker Compose.
APP_PORT=3000
